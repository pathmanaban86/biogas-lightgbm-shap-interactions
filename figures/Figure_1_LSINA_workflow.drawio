<mxfile host="app.diagrams.net"><diagram id="lsina" name="Figure 1"><mxGraphModel dx="1000" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="905" pageHeight="746" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="&lt;b&gt;Public dataset (Kaggle)&lt;/b&gt;&lt;br&gt;15,298 records · 5,479 dates (2010–2024) · 18 inputs: 10 feedstock, 5 operational, 3 climate" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0b0b0b;strokeWidth=1.2;fontSize=13;fontFamily=Helvetica;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="825" height="54" as="geometry"/></mxCell><mxCell id="n4" value="1&amp;nbsp;&amp;nbsp;Data audit and preprocessing" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2a78d6;strokeWidth=1.5;fontSize=14;fontStyle=1;align=left;spacingLeft=12;fontFamily=Helvetica;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="275" height="66" as="geometry"/></mxCell><mxCell id="n5" value="• Missing values, duplicates, physical ranges (RH capped at 100%)&lt;br&gt;• Trend, autocorrelation and seasonality checks" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8984;strokeWidth=1;fontSize=12;align=left;spacingLeft=12;fontFamily=Helvetica;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="345" y="110" width="520" height="66" as="geometry"/></mxCell><mxCell id="n6" style="endArrow=none;strokeColor=#8a8984;strokeWidth=1;dashed=1;html=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" style="endArrow=block;endFill=1;strokeColor=#0b0b0b;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="2&amp;nbsp;&amp;nbsp;Chronological partitioning" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2a78d6;strokeWidth=1.5;fontSize=14;fontStyle=1;align=left;spacingLeft=12;fontFamily=Helvetica;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="275" height="66" as="geometry"/></mxCell><mxCell id="n9" value="• Split on whole dates: development 2010–2021 (n = 12,240)&lt;br&gt;• Held-out test 2022–2024 (n = 3,058)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8984;strokeWidth=1;fontSize=12;align=left;spacingLeft=12;fontFamily=Helvetica;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="345" y="202" width="520" height="66" as="geometry"/></mxCell><mxCell id="n10" style="endArrow=none;strokeColor=#8a8984;strokeWidth=1;dashed=1;html=1;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" style="endArrow=block;endFill=1;strokeColor=#0b0b0b;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="3&amp;nbsp;&amp;nbsp;Model tuning and comparison" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2a78d6;strokeWidth=1.5;fontSize=14;fontStyle=1;align=left;spacingLeft=12;fontFamily=Helvetica;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="40" y="294" width="275" height="66" as="geometry"/></mxCell><mxCell id="n13" value="• Linear, RF, XGBoost, CatBoost, LightGBM, additive LightGBM&lt;br&gt;• 5-fold expanding-window CV + Optuna; test: 5 seeds, bootstrap 95% CI" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8984;strokeWidth=1;fontSize=12;align=left;spacingLeft=12;fontFamily=Helvetica;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="345" y="294" width="520" height="66" as="geometry"/></mxCell><mxCell id="n14" style="endArrow=none;strokeColor=#8a