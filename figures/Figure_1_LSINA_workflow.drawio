irs)&lt;br&gt;• Additive null (100 refits), BH-FDR; graph of pairs with q &lt; 0.05" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8984;strokeWidth=1;fontSize=12;align=left;spacingLeft=12;fontFamily=Helvetica;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="345" y="478" width="520" height="66" as="geometry"/></mxCell><mxCell id="n22" style="endArrow=none;strokeColor=#8a8984;strokeWidth=1;dashed=1;html=1;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" style="endArrow=block;endFill=1;strokeColor=#0b0b0b;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n16" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="6&amp;nbsp;&amp;nbsp;Group contribution and seasons" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2a78d6;strokeWidth=1.5;fontSize=14;fontStyle=1;align=left;spacingLeft=12;fontFamily=Helvetica;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="275" height="66" as="geometry"/></mxCell><mxCell id="n25" value="• SHAP group share, grouped permutation, drop-group retraining&lt;br&gt;• Kruskal–Wallis + Dunn (IMD seasons)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8984;strokeWidth=1;fontSize=12;align=left;spacingLeft=12;fontFamily=Helvetica;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="345" y="570" width="520" height="66" as="geometry"/></mxCell><mxCell id="n26" style="endArrow=none;strokeColor=#8a8984;strokeWidth=1;dashed=1;html=1;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" style="endArrow=block;endFill=1;strokeColor=#0b0b0b;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n20" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="